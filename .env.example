# Copy this file to .env and fill in the values.

# PostgreSQL connection string (Neon). Use the pooled URL for the app.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Comma-separated list of admin Gmail addresses allowed into the admin portal
ADMIN_EMAILS="youradmin@gmail.com"

# Firebase web config (Firebase console -> Project settings -> General)
FIREBASE_API_KEY="your-api-key"
FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="1234567890"
FIREBASE_APP_ID="1:1234567890:web:abcdef1234567890"
FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# NVIDIA NIM API key for AI grading of written answers (server side only).
# Get a key from https://build.nvidia.com. The model reads the question and the manager's
# accepted answers and returns a score plus a reason. If the call fails, grading falls back to
# exact/keyword comparison of the answer against the accepted answers.
NVIDIA_CHAT_KEY="nvapi-your-key"

# Model used for AI grading.
NVIDIA_CHAT_MODEL="nvidia/nemotron-3-super-120b-a12b"

# Cloudinary account used to store PDF answers and manager reference PDFs (server side only).
# The browser never sees the secret: files are uploaded through /api/uploads/pdf.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Folder inside Cloudinary where uploaded PDFs are kept.
CLOUDINARY_UPLOAD_FOLDER="ieee-quiz-pdfs"

# Limits applied to every uploaded PDF.
# MAX_PDF_PAGES: how many pages the AI is allowed to analyse in one document.
# MAX_PDF_BYTES: maximum upload size in bytes (default 10MB).
# MAX_PDF_CHARS: maximum characters of extracted text sent to the model (default 60000).
MAX_PDF_PAGES="25"
MAX_PDF_BYTES="10485760"
MAX_PDF_CHARS="60000"