# PostgreSQL connection string (Neon/Neon-compatible). 
# For Neon, use the pooled URL for the app and remove channel_binding=require.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Port the server listens on
PORT=3000

# Comma-separated list of admin GMail addresses allowed into the admin portal
ADMIN_EMAILS="youradmin@gmail.com"

# Optional: Comma-separated list of allowed CORS origins.
# Defaults to http://localhost:3000 when unset.
ALLOWED_ORIGINS="http://localhost:3000,https://yourdomain.com"

# Set to production on hosted platforms (enables static caching)
NODE_ENV=development